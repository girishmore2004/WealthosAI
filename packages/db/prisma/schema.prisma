// WealthOS AI — core data model (Phase 1 MVP slice: auth, household, income, expenses, dashboard).
// Uses PostgreSQL only — no paid managed DB required; docker-compose.yml runs it locally for free.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MEMBER
}

enum TaxRegime {
  OLD
  NEW
}

enum RiskProfile {
  CONSERVATIVE
  MODERATE
  AGGRESSIVE
}

enum CategoryType {
  NEED
  WANT
  SAVINGS
}

enum IncomeSource {
  SALARY
  FREELANCE
  BUSINESS
  RENT
  DIVIDEND
  INTEREST
  BONUS
  PENSION
  OTHER
}

enum Recurrence {
  ONE_TIME
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  WALLET
  OTHER
}

enum InvestmentType {
  MUTUAL_FUND
  STOCK
  ETF
  EPF
  PPF
  NPS
  FD
  BOND
  GOLD
  SILVER
  REAL_ESTATE
  CRYPTO
  BUSINESS_EQUITY
  OTHER
}

enum RiskLevel {
  LOW
  MODERATE
  HIGH
}

enum Liquidity {
  LIQUID
  SEMI_LIQUID
  ILLIQUID
}

enum LoanType {
  HOME
  CAR
  EDUCATION
  PERSONAL
  BUSINESS
  CREDIT_CARD
  FAMILY
  OTHER
}

enum InsuranceType {
  HEALTH
  TERM
  VEHICLE
  HOME
  PERSONAL_ACCIDENT
  CRITICAL_ILLNESS
  TRAVEL
  BUSINESS
}

enum GoalType {
  EMERGENCY_FUND
  HOUSE
  LAND
  CAR
  MARRIAGE
  CHILD_EDUCATION
  RETIREMENT
  EARLY_RETIREMENT
  BUSINESS_EXPANSION
  VACATION
  HEALTHCARE_RESERVE
  PASSIVE_INCOME
  FAMILY_SUPPORT
  OTHER
}

model Household {
  id         String            @id @default(cuid())
  name       String
  createdAt  DateTime          @default(now())
  members    User[]
  dependents Dependent[]
  invites    HouseholdInvite[]   // NEW
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  phone        String?     @unique
  name         String?
  dateOfBirth  DateTime?
  role         Role        @default(OWNER)
  taxRegime    TaxRegime   @default(NEW)
  riskProfile  RiskProfile @default(MODERATE)
  household    Household?  @relation(fields: [householdId], references: [id])
  householdId  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  sessions  Session[]
  otpCodes  OtpCode[]
  incomes   Income[]
  expenses  Expense[]
  auditLogs AuditLog[]
  goals              Goal[]
  investments        Investment[]
  loans              Loan[]
  insurancePolicies  InsurancePolicy[]
  taxDeductions      TaxDeduction[]
  retirementProfile  RetirementProfile?
  alerts             Alert[]
  settings           UserSettings?
  properties         Property[]
  businesses         Business[]
  documents          Document[]
  coachInteractions  CoachInteraction[]
  savedScenarios     SavedScenario[]
  aiInteractionLogs  AiInteractionLog[]
  aiJobs             AiJob[]
  aiEmbeddingChunks  AiEmbeddingChunk[]
  aiSearchLogs       AiSearchLog[]
  agenticCoachRuns   AgenticCoachRun[]
  scenarioStudioRuns ScenarioStudioRun[]
  mlInsightRuns      MlInsightRun[]
  ingestionBatches   IngestionBatch[]
  ingestionReviewItems IngestionReviewItem[]
  sentHouseholdInvites HouseholdInvite[] @relation("HouseholdInviteSentBy")   // NEW
  budgets Budget[]   // NEW
  aiSourceIndexStates AiSourceIndexState[]
 // --- Add inside model User, alongside its other relation fields ---
  coachFinancialMemory CoachFinancialMemory? // NEW — Phase 20
  coachPlans           CoachPlan[]           // NEW — Phase 20
  coachTasks           CoachTask[]           // NEW — Phase 20
  coachNudges          CoachNudge[]          // NEW — Phase 20

  scenarioStudioRuns ScenarioStudioRun[]
  scenarioMonteCarloRuns ScenarioMonteCarloRun[]
  scenarioOptimizationRuns ScenarioOptimizationRun[]
  ingestionBatches   IngestionBatch[]
  ingestionReviewItems IngestionReviewItem[]
  merchantCategoryMemories MerchantCategoryMemory[]
  suggestionRankingProfile SuggestionRankingProfile?

  @@index([householdId])
}

// --- Phase 13: Scenario Studio ------------------------------------------------------
//
// See README "Phase 13 — Scenario Studio" for the full design. Built entirely on top
// of the existing deterministic SimulatorService/simulator.engine.ts (Phase 5) — every
// variant's numbers come from that same engine, re-run with different (deterministically
// derived) parameters. Nothing here invents a financial projection; the AI layer only
// parses prompts into structured params and explains an already-computed ranking.

model ScenarioStudioRun {
  id              String   @id @default(cuid())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  prompt          String
  scenarioType    String
  baseParams      Json
  targetGoalIds   String[]
  variants        Json // summarized per-variant results (label, params, key numbers, feasibility)
  sensitivity     Json // SensitivityDimension[] output
  rankedOrder     String[] // variant labels, best to worst
  explanation     String
  explanationConfidence Decimal @db.Decimal(4, 3)
  verificationPassed Boolean
  // NEW (Phase 16): the fast, reduced-fidelity Monte Carlo preview attached to the
  // ranked winner — nullable because a preview failure never blocks the rest of the
  // deterministic result (see ScenarioStudioService.tryMonteCarloSummary()).
  monteCarloSummary Json?
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
}

// --- Phase 16: Scenario Studio — Probabilistic Planning ------------------------------
//
// Two new audit-log tables, parallel in spirit to ScenarioStudioRun above: one per new
// endpoint (POST /scenario-studio/simulate, POST /scenario-studio/optimize). Neither
// touches ScenarioStudioRun or SavedScenario — both new features call the existing
// SimulatorService (via MonteCarloSimulationService) to gather the real baseline and
// only log their own additional layer here, same pattern Phase 13's own migration
// comment already established.

model ScenarioMonteCarloRun {
  id                    String   @id @default(cuid())
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String
  scenarioType          String
  params                Json
  config                Json // MonteCarloConfigDTO snapshot (iterations, horizon, seed, assumptions)
  terminalPercentiles   Json // { p10, p25, p50, p75, p90 }
  probabilityOfNetWorthDecline Decimal @db.Decimal(6, 5)
  riskLevel             String
  coefficientOfVariation Decimal @db.Decimal(10, 5)
  explanation           String
  explanationConfidence Decimal @db.Decimal(4, 3)
  verificationPassed    Boolean
  createdAt             DateTime @default(now())

  @@index([userId, createdAt])
}

model ScenarioOptimizationRun {
  id                    String   @id @default(cuid())
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String
  scenarioType          String
  constraints           Json
  recommendedParams     Json
  searchRange           Json // { min, max }
  candidatesEvaluated   Int
  feasible              Boolean
  violatedConstraints   String[]
  riskAdjustedScore     Decimal @db.Decimal(16, 2)
  explanation           String
  explanationConfidence Decimal @db.Decimal(4, 3)
  verificationPassed    Boolean
  createdAt             DateTime @default(now())

  @@index([userId, createdAt])
}

model HouseholdInvite {
  id          String                @id @default(cuid())
  household   Household             @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String
  invitedBy   User                  @relation("HouseholdInviteSentBy", fields: [invitedById], references: [id], onDelete: Cascade)
  invitedById String
  email       String
  status      HouseholdInviteStatus @default(PENDING)
  // Never store the raw token — same discipline as OtpCode.codeHash / Session.tokenHash
  // elsewhere in this schema. See HouseholdService's doc comments for the full flow.
  tokenHash   String                @unique
  createdAt   DateTime              @default(now())
  expiresAt   DateTime
  respondedAt DateTime?

  @@index([householdId])
  @@index([email])
}

enum HouseholdInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  REVOKED
}
model Dependent {
  id           String     @id @default(cuid())
  household    Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId  String
  name         String
  relation     String
  dateOfBirth  DateTime?
  createdAt    DateTime   @default(now())

  @@index([householdId])
}

model Session {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  userAgent  String?
  ipAddress  String?
  revoked    Boolean  @default(false)
  // SHA-256 hash of the opaque bearer token issued to the client (see
  // auth/session.service.ts). NULL only for sessions created before this migration —
  // those are served by a temporary, feature-flagged legacy fallback until they expire.
  // Never store the raw token; this column exists purely for lookup, exactly like
  // OtpCode.codeHash.
  tokenHash  String?  @unique

  @@index([userId])
}

// OTP codes are never stored in plaintext — only a hash — and always expire.
model OtpCode {
  id          String   @id @default(cuid())
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String?
  identifier  String   // email used for this login attempt
  codeHash    String
  expiresAt   DateTime
  consumed    Boolean  @default(false)
  createdAt   DateTime @default(now())
  // Failed-guess counter against this specific outstanding code (audit/durability
  // signal). The primary brute-force lockout enforcement is the Redis-backed
  // per-identifier counter in AuthService — see registerFailedAttempt().
  attempts    Int      @default(0)

  @@index([identifier])
}

model Budget {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  category      Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId    String
  monthlyAmount Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, categoryId])
}

model Category {
  id        String        @id @default(cuid())
  name      String        @unique
  type      CategoryType
  icon      String?
  isSystem  Boolean       @default(true)
  expenses  Expense[]
  budgets   Budget[]        // NEW
}

model Income {
  id          String        @id @default(cuid())
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  source      IncomeSource
  label       String
  amount      Decimal       @db.Decimal(14, 2)
  currency    String        @default("INR")
  recurrence  Recurrence    @default(MONTHLY)
  receivedAt  DateTime
  notes       String?
  createdAt   DateTime      @default(now())

  @@index([userId, receivedAt])
}

model Expense {
  id             String        @id @default(cuid())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  category       Category      @relation(fields: [categoryId], references: [id])
  categoryId     String
  merchant       String?
  amount         Decimal       @db.Decimal(14, 2)
  currency       String        @default("INR")
  spentAt        DateTime
  paymentMethod  PaymentMethod @default(UPI)
  notes          String?
  isRecurring    Boolean       @default(false)
  createdAt      DateTime      @default(now())

  @@index([userId, spentAt])
  @@index([categoryId])
}

model AuditLog {
  id         String   @id @default(cuid())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId     String?
  action     String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

model Goal {
  id                   String    @id @default(cuid())
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId               String
  type                 GoalType
  name                 String
  targetAmount         Decimal   @db.Decimal(14, 2)
  targetDate           DateTime
  currentAmount        Decimal   @db.Decimal(14, 2) @default(0)
  monthlyContribution  Decimal   @db.Decimal(14, 2) @default(0)
  // Optional assumed annual growth rate for this goal's linked investment value,
  // applied only when projecting forward to the target date (requiredMonthlyContribution
  // / probabilityOfSuccess) — never to progressPercent, which describes today's actual
  // state. Unset means "assume no growth," identical to the original calculation. See
  // GoalsService.enrich()'s doc comment.
  assumedAnnualReturnPercent Decimal? @db.Decimal(5, 2)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  investments Investment[]

  @@index([userId])
}

model Investment {
  id             String          @id @default(cuid())
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  type           InvestmentType
  name           String
  currentValue   Decimal         @db.Decimal(14, 2)
  costBasis      Decimal         @db.Decimal(14, 2)
  purchaseDate   DateTime
  riskLevel      RiskLevel       @default(MODERATE)
  liquidity      Liquidity       @default(SEMI_LIQUID)
  goal           Goal?           @relation(fields: [goalId], references: [id], onDelete: SetNull)
  goalId         String?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([userId])
  @@index([goalId])
}

model Loan {
  id                     String    @id @default(cuid())
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                 String
  type                   LoanType
  lender                 String
  principal              Decimal   @db.Decimal(14, 2)
  outstandingPrincipal   Decimal   @db.Decimal(14, 2)
  interestRateAnnual     Decimal   @db.Decimal(5, 2)
  tenureMonths           Int
  emiAmount              Decimal   @db.Decimal(14, 2)
  startDate              DateTime
  notes                  String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  properties Property[]

  @@index([userId])
}

model InsurancePolicy {
  id                String          @id @default(cuid())
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  type              InsuranceType
  provider          String
  policyNumber      String?
  premiumAmount     Decimal         @db.Decimal(14, 2)
  premiumFrequency  Recurrence      @default(YEARLY)
  coverageAmount    Decimal         @db.Decimal(14, 2)
  renewalDate       DateTime
  nomineeName       String?
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  properties Property[]

  @@index([userId])
}

// --- Phase 3: Tax, Retirement, Alerts, Settings -----------------------------------

enum TaxSection {
  SECTION_80C
  SECTION_80D
  SECTION_80CCD_1B
  HRA
  HOME_LOAN_INTEREST
  SECTION_80TTA
  SECTION_80E
  OTHER
}

enum AlertType {
  EMI_DUE
  INSURANCE_RENEWAL
  BUDGET_OVERSPEND
  GOAL_DELAY
  SUBSCRIPTION_RENEWAL
  DEBT_STRESS
  DOCUMENT_EXPIRY
  BUSINESS_OBLIGATION_DUE
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum DigestFrequency {
  DAILY
  WEEKLY
  OFF
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

enum AppLanguage {
  EN
  HI
  MR
}

model TaxDeduction {
  id             String      @id @default(cuid())
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  section        TaxSection
  description    String
  amount         Decimal     @db.Decimal(12, 2)
  financialYear  String      // e.g. "2026-27"
  createdAt      DateTime    @default(now())

  @@index([userId, financialYear])
}

model RetirementProfile {
  id                                  String    @id @default(cuid())
  user                                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                              String    @unique
  targetRetirementAge                 Int       @default(60)
  desiredMonthlyIncomeToday           Decimal   @db.Decimal(12, 2)
  inflationRatePercent                Decimal   @db.Decimal(5, 2) @default(6)
  expectedReturnPreRetirementPercent  Decimal   @db.Decimal(5, 2) @default(11)
  expectedReturnPostRetirementPercent Decimal   @db.Decimal(5, 2) @default(7)
  // Optional user-estimated life expectancy. When set (and greater than
  // targetRetirementAge), RetirementService.computePlan() derives the post-retirement
  // drawdown horizon as (lifeExpectancyAge - targetRetirementAge) instead of the flat
  // 25-year assumption used when this is unset — see that method's doc comment.
  lifeExpectancyAge                   Int?
  // Optional expected guaranteed pension/annuity income (e.g. EPS, an employer
  // pension) at retirement, in nominal rupees at the retirement date (not today's
  // rupees — same "already future-valued" convention as monthlyIncomeAtRetirement).
  // Reduces how much of the target monthly income needs to be self-funded from the
  // investment corpus — see computePlan()'s doc comment.
  expectedMonthlyPensionAtRetirement  Decimal?  @db.Decimal(12, 2)
  createdAt                           DateTime  @default(now())
  updatedAt                           DateTime  @updatedAt
}
model Alert {
  id          String         @id @default(cuid())
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  type        AlertType
  severity    AlertSeverity  @default(INFO)
  title       String
  message     String
  dedupeKey   String         // stable key so re-running the rules engine upserts instead of duplicating
  dueDate     DateTime?
  isRead      Boolean        @default(false)
  createdAt   DateTime       @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, isRead])
}

model UserSettings {
  id                  String            @id @default(cuid())
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              String            @unique
  notifyEmail         Boolean           @default(true)
  digestFrequency     DigestFrequency   @default(WEEKLY)
  theme               Theme             @default(LIGHT)
  language            AppLanguage       @default(EN)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

// --- Phase 4: Property, Business Tracker, Document Vault, Reports --------------

enum PropertyType {
  HOUSE
  APARTMENT
  PLOT
  LAND
  COMMERCIAL
  RENTAL
}

enum BusinessTransactionType {
  REVENUE
  EXPENSE
  OWNER_DRAWING
}

enum BusinessEntityType {
  SOLE_PROPRIETORSHIP
  PARTNERSHIP
  LLP
  PRIVATE_LIMITED
  OTHER
}

enum ObligationStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum DocumentCategory {
  PAN
  AADHAAR
  SALARY_SLIP
  FORM_16
  INSURANCE_POLICY
  LOAN_DOCUMENT
  MF_STATEMENT
  TAX_RETURN
  PROPERTY_PAPER
  BUSINESS_DOCUMENT
  RECEIPT
  BILL
  OTHER
}

enum OcrStatus {
  NOT_APPLICABLE
  PENDING
  DONE
  FAILED
}

model Property {
  id                     String        @id @default(cuid())
  user                   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                 String
  type                   PropertyType
  name                   String
  address                String?
  currentValue           Decimal       @db.Decimal(14, 2)
  purchasePrice          Decimal       @db.Decimal(14, 2)
  purchaseDate           DateTime
  isRented               Boolean       @default(false)
  monthlyRentalIncome    Decimal?      @db.Decimal(12, 2)
  annualMaintenanceCost  Decimal       @db.Decimal(12, 2) @default(0)
  annualPropertyTax      Decimal       @db.Decimal(12, 2) @default(0)
  // Soft links to an existing Loan/InsurancePolicy the property is financed/insured
  // under — optional, and setting the loan/policy to null on delete (never cascades a
  // property away just because its mortgage or policy record was removed).
  loan                   Loan?             @relation(fields: [loanId], references: [id], onDelete: SetNull)
  loanId                 String?
  insurancePolicy        InsurancePolicy?  @relation(fields: [insurancePolicyId], references: [id], onDelete: SetNull)
  insurancePolicyId      String?
  notes                  String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@index([userId])
  @@index([loanId])
  @@index([insurancePolicyId])
}

model Business {
  id                 String             @id @default(cuid())
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String
  name               String
  description        String?
  entityType         BusinessEntityType @default(SOLE_PROPRIETORSHIP)
  currency           String             @default("INR")
  startedAt          DateTime?
  ownershipPercent   Decimal?           @db.Decimal(5, 2)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  transactions  BusinessTransaction[]
  obligations   BusinessObligation[]

  @@index([userId])
}

model BusinessTransaction {
  id           String                    @id @default(cuid())
  business     Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId   String
  type         BusinessTransactionType
  category     String?
  amount       Decimal                   @db.Decimal(14, 2)
  occurredAt   DateTime
  description  String?
  isRecurring  Boolean                   @default(false)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@index([businessId, occurredAt])
}

model BusinessObligation {
  id           String              @id @default(cuid())
  business     Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId   String
  title        String
  dueDate      DateTime
  amount       Decimal?            @db.Decimal(12, 2)
  recurrence   Recurrence          @default(MONTHLY)
  vendor       String?
  status       ObligationStatus    @default(PENDING)
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([businessId, dueDate])
}

// File bytes live on local/self-hosted disk storage behind a DocumentStorageAdapter
// (see apps/api/src/documents/adapters) — storageKey is an opaque pointer into that
// adapter, never a raw filesystem path exposed to the client. OCR is a real,
// implemented pipeline stage (status machine + text/summary fields) with a mock
// adapter behind the same OcrAdapter interface used for the real thing later.
model Document {
  id           String            @id @default(cuid())
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  category     DocumentCategory
  fileName     String
  mimeType     String
  sizeBytes    Int
  storageKey   String
  tags         String[]
  expiryDate   DateTime?
  ocrStatus    OcrStatus         @default(NOT_APPLICABLE)
  ocrText      String?
  summary      String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([userId, category])
  @@index([userId, expiryDate])
}

// --- Phase 10: AI Gateway ops (prompt registry, interaction log, background jobs) --
//
// These three models are infrastructure for the real AiGateway (apps/api/src/ai/),
// not a product feature themselves. They exist so every model call is versioned,
// logged, and — for long-running work — trackable as a job rather than blocking an
// HTTP request. See README "Phase 10 — AI Gateway foundation" for the full design.

enum AiInteractionStatus {
  OK // model returned valid, schema-conformant output on the first or a retried attempt
  MALFORMED_FALLBACK // every retry produced invalid output; a caller-supplied fallback was used
  ERROR // the underlying model call itself failed (network/5xx/timeout), no output at all
}

// Every call an AiGatewayService method makes is logged here — this is what the
// ops-layer health check, cache-hit-rate, and "what did the model actually see"
// tracing all read from. `redactedInput`/`rawOutput` are best-effort truncated to keep
// rows small; this is an audit/debug trail, not a full transcript store.
model AiInteractionLog {
  id             String               @id @default(cuid())
  user           User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId         String?
  feature        String // e.g. "coach.explain", "rag.search" — caller-supplied, free text by design
  taskType       String // "classification" | "extraction" | "generation" | "summarization" | "ranking"
  promptName     String
  promptVersion  Int
  model          String // actual Groq model id used for this call, or "cache" on a cache hit
  status         AiInteractionStatus
  confidence     Decimal?             @db.Decimal(4, 3) // 0.000–1.000, self-reported by the model — see AiGatewayService doc comment
  retries        Int                  @default(0)
  latencyMs      Int
  cacheHit       Boolean              @default(false)
  cacheType      String? // "exact" | "semantic" | null — which AiCacheService path served this hit; null when cacheHit is false. See ai-cache.service.ts.
  redactedInput  String // post-redaction input actually sent to the model, truncated to ~4kb by the logger
  rawOutput      String? // truncated to ~4kb; null when status is ERROR
  errorMessage   String?
  promptTokens       Int      @default(0) // real usage reported by Groq's own response `usage` block — NOT TokenBudgetService's pre-call char/4 estimate. 0 on a cache hit.
  completionTokens   Int      @default(0)
  estimatedCostUsd   Decimal? @db.Decimal(12, 8) // computed by TokenAccountingService from the real usage above against config ai.modelPricing; null (not 0) when `model` isn't in that pricing table
  routingReason      String? // see RoutingReason in ai-gateway.types.ts — why ModelRouterService picked `model` for this call
  fallbackUsed       Boolean  @default(false) // true when `model` was NOT ModelRouterService's first-choice candidate for this call
  groundingScore     Decimal? @db.Decimal(4, 3) // 0.000–1.000; null when the caller didn't supply AiCallOptions.groundingContext (not measured, not "0 = hallucinated"). See grounding.service.ts.
  hallucinationRisk  String   @default("unmeasured") // "unmeasured" | "low" | "medium" | "high" — coarse bucket derived from groundingScore
  createdAt      DateTime             @default(now())

  @@index([userId, createdAt])
  @@index([feature, createdAt])
  @@index([model, taskType, createdAt])
}

// A named, versioned prompt template. New versions are inserted rather than mutated in
// place (`isActive` flips) so `AiInteractionLog.promptVersion` always points at
// immutable template text — required for the "what exactly did we ask the model"
// auditability the ops layer promises.
model AiPromptVersion {
  id         String   @id @default(cuid())
  name       String
  version    Int
  template   String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([name, version])
  @@index([name, isActive])
}

enum AiJobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

// Postgres is the source of truth for job status (same pattern as Session: Redis/BullMQ
// is the fast transport, this table is what a client actually polls). `idempotencyKey`
// is optional per job type — callers that want "don't enqueue this twice" set it and
// AiQueueService upserts against the (userId, idempotencyKey) unique constraint instead
// of creating a duplicate row.
model AiJob {
  id              String      @id @default(cuid())
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId          String?
  type            String // registered handler name, e.g. "ai.health.selfTest"
  status          AiJobStatus @default(QUEUED)
  idempotencyKey  String?
  input           Json
  result          Json?
  error           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status])
}

// --- Phase 11: RAG engine ----------------------------------------------------------
//
// See README "Phase 11 — RAG engine" for the full design. Short version: each user's
// own data (documents, reports, coach history, alerts, a current financial snapshot)
// gets chunked and embedded into AiEmbeddingChunk; AiSearchLog records what a search
// actually retrieved and answered, for the "why these sources were used" UI panel and
// for audit — same spirit as AiInteractionLog, but search-specific (it needs to keep
// the ordered list of cited chunk ids, which a generic interaction log row doesn't).

enum AiSourceType {
  DOCUMENT
  REPORT
  COACH_INTERACTION
  ALERT
  SNAPSHOT // a point-in-time dashboard snapshot indexed at reindex time — see the
  // README limitation on why this is "current state as of last reindex", not a real
  // historical time series (no periodic snapshots are stored anywhere in the app yet).
}

// One embedded chunk of some larger source document. `sourceId` is a loose reference
// (the id of a Document/CoachInteraction/etc. row, or a synthetic id for a
// report/snapshot) rather than a Prisma relation, because a single chunk table
// spanning five very different source tables would need five nullable FK columns for
// no real benefit — nothing joins back through this table relationally, retrieval
// always reads sourceType+sourceId and re-fetches the origin row itself if it needs
// more than what's already denormalized into `metadata`.
model AiEmbeddingChunk {
  id              String       @id @default(cuid())
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  sourceType      AiSourceType
  sourceId        String
  chunkIndex      Int
  text            String
  // The larger parent section this child chunk was extracted from at index time (see
  // ChunkerService's parent-child hierarchical chunking) — never itself embedded or
  // matched, carried purely so a matched child chunk can be handed to synthesis/
  // grounding with real surrounding context ("contextual chunk expansion") instead of
  // just its own narrow ~180-word window.
  parentText      String       @default("")
  // Denormalized display fields so retrieval results can render a citation card
  // without a second query per source table: { title, category?, occurredAt? }
  metadata        Json
  embedding       Float[]
  tokenCount      Int
  sourcePriority  Int          @default(0) // static per-sourceType trust weight, see HybridRetrievalService
  sourceCreatedAt DateTime // drives recency weighting — the origin record's own date, not this row's createdAt
  createdAt       DateTime     @default(now())
  // Which EMBEDDING_MODEL_VERSION produced `embedding` — compared against the
  // currently-active version on each reindex so a model/pooling change forces a full
  // re-embed instead of silently mixing incompatible vector spaces in one similarity
  // search. See embedding.service.ts and RagIndexingService#reindexUser.
  embeddingModelVersion Int    @default(1)
  // Layer 3 (knowledge-graph / document-relationship traversal) edges, computed once
  // at index time — see RagIndexingService#computeRelatedSourceIds. Every chunk
  // belonging to the same source shares the same relatedSourceIds.
  relatedSourceIds String[]    @default([])

  @@index([userId, sourceType])
  @@index([userId, sourceCreatedAt])
  @@index([userId, sourceId])
  @@index([userId, embeddingModelVersion])
}
// Tracks the last-indexed content hash per (user, source) pair so RagIndexingService
// can do incremental/delta reindexing — only sources whose content actually changed
// since their last recorded state get re-chunked and re-embedded, rather than a full
// delete-and-rebuild of every user's entire index on every reindex call. A row with no
// matching current source (Document deleted, etc.) signals "this source's chunks
// should be removed" the next time that user is reindexed.
model AiSourceIndexState {
  id          String       @id @default(cuid())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  sourceType  AiSourceType
  sourceId    String
  contentHash String // sha256 of the source's (text, metadata) pair as of last index
  chunkCount  Int
  indexedAt   DateTime     @default(now())

  @@unique([userId, sourceType, sourceId])
  @@index([userId])
}
model AiSearchLog {
  id                String   @id @default(cuid())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  query             String
  rewrittenQueries  String[]
  retrievedChunkIds String[]
  citedChunkIds     String[]
  hadEvidence       Boolean
  retrievalConfidence Decimal @db.Decimal(4, 3)
  answerConfidence  Decimal? @db.Decimal(4, 3)
  answer            String
  createdAt         DateTime @default(now())
  // QueryRewriteService's classification for this search — see rag.constants.ts's
  // QueryType/QueryComplexity — kept for observability into how often each profile/
  // adaptive top-k tier actually gets used, not read back by any code path today.
  queryType         String?
  complexity        String?
  // The gateway's independent numeric-grounding score/risk bucket for the synthesized
  // answer (see AnswerSynthesisService/GroundingService) — null/"unmeasured" on the
  // no-evidence and AI-unavailable paths, where no model response existed to score.
  groundingScore    Decimal? @db.Decimal(4, 3)
  hallucinationRisk String?
  // Per-citation confidence bucket (see RagService#citationConfidence), keyed by
  // chunk id — { chunkId, confidence }[]. Json rather than a join table since nothing
  // queries into it relationally, same reasoning as AiEmbeddingChunk's own metadata.
  citationConfidences Json?

  @@index([userId, createdAt])
}

// --- Phase 12: Agentic Coach --------------------------------------------------------
//
// See README "Phase 12 — Agentic Coach" for the full design. Short version: this is
// an EXPLANATION LAYER over the existing deterministic CoachService/matchIntent
// router (Phase 5), not a replacement for it — a known question still takes the
// deterministic path unchanged; the model is only consulted for questions the
// original router doesn't recognize, or to add explanation/context around an already-
// grounded deterministic answer. AgenticCoachRun is a richer record than
// CoachInteraction (Phase 5) specifically for that: it captures the plan, the raw
// facts gathered, and whether the composed answer passed numeric-consistency
// verification — CoachInteraction itself is untouched and keeps working exactly as
// it did before this phase.

enum CoachPath {
  DETERMINISTIC
  ADVANCED
}

// --- AgenticCoachRun gets 3 new columns (inserted just before createdAt) ---
model AgenticCoachRun {
  id                String     @id @default(cuid())
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  question          String
  path              CoachPath
  matchedIntent     String?
  advancedIntent    String?
  plan              String[]
  facts             Json
  citedSources      String[]
  answer            String
  confidence        Decimal    @db.Decimal(4, 3)
  verificationPassed Boolean
  staleAdviceNote   String?
  // --- Phase 20 additions (multi-agent planner) — both nullable/defaulted, so every
  // pre-existing row (and every pre-existing INSERT that doesn't set them) behaves
  // exactly as before: an empty array, not a schema break.
  criticFlags       String[]   @default([]) // e.g. "OVERPROMISING", "UNSAFE_ADVICE" — see CriticAgentService
  createdTaskIds    String[]   @default([]) // CoachTask ids the Execution/Task Agent created from this run, if any
  planId            String?    // set when this run created or reported on a CoachPlan
  createdAt         DateTime   @default(now())

  @@index([userId, createdAt])
  @@index([userId, matchedIntent])
  @@index([userId, advancedIntent])
}

// --- Phase 20: Coach Multi-Agent Planner --------------------------------------------
//
// Turns the Phase 12 Agentic Coach from a single-turn "answer this question" agent
// into a persistent multi-agent financial planner. Six cooperating agents, each with
// one job:
//   - Planner Agent    (planning/financial-plan-agent.service.ts) — builds/maintains
//     CoachPlan + CoachPlanStep rows.
//   - Retriever Agent  (gathering/data-gatherer.service.ts) — fetches user-specific
//     data from the money modules. Unchanged data-access pattern from Phase 12.
//   - Calculator Agent (calculation/finance-calculator.service.ts) — deterministic
//     finance math only (EMI, prepayment payoff, savings/goal projection, retirement
//     corpus, tax estimate passthrough). Never calls the LLM.
//   - Verifier Agent   (verification/verifier-agent.service.ts) — wraps
//     NumericConsistencyVerifier and additionally checks a composed answer's claims
//     against the CoachPlan it's reporting on.
//   - Critic Agent     (verification/critic-agent.service.ts) — screens composed
//     answers for over-promising language and unsafe-advice patterns, heuristically
//     and (when available) via one closed-set LLM classification call.
//   - Execution/Task Agent (execution/task-agent.service.ts) — turns advice into
//     concrete CoachTask rows with due dates.
//
// All of this is additive: CoachPath, AgenticCoachRun, CoachInteraction, and every
// Phase 5/12 table above are untouched in shape (aside from the three new nullable/
// defaulted columns on AgenticCoachRun immediately above, which are pure additions).

enum CoachPlanType {
  DEBT_PAYOFF
  SAVINGS_TARGET
  RETIREMENT
  INVESTMENT_ALLOCATION
  CUSTOM
}

enum CoachPlanStatus {
  ACTIVE
  AT_RISK
  COMPLETED
  ABANDONED
}

enum CoachStepStatus {
  PENDING
  IN_PROGRESS
  DONE
  SKIPPED
}

enum CoachTaskStatus {
  OPEN
  DONE
  DISMISSED
}

enum CoachProgressSource {
  USER_QUERY
  PROACTIVE_CHECK
}

enum CoachNudgeSeverity {
  INFO
  WARNING
  CRITICAL
}

// Distilled, structured cross-session memory — deliberately separate from
// AgenticCoachRun (which is the full raw per-turn log). One row per user. Agents read
// this before planning/composing and write back to it after a run that surfaces a new
// constraint or preference, so "the coach remembers I don't want to touch my
// emergency fund" survives across sessions without re-deriving it from run history
// every time.
model CoachFinancialMemory {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String   @unique
  // Array of { text, source ("user_stated" | "inferred"), sourceRunId, createdAt } —
  // e.g. "don't want to touch the emergency fund", "prefers avalanche over snowball".
  constraints Json      @default("[]")
  // Array of { key, value, updatedAt } — e.g. riskToleranceOverride, communicationTone.
  preferences Json      @default("[]")
  // Free-form per-goal/plan context the agents have learned, keyed by a label (goal
  // id or plan id) — e.g. "house goal: flexible on the target date, firm on amount".
  goalNotes   Json      @default("{}")
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

// A persistent, long-running financial plan the Planner Agent builds and the
// Execution Monitor (plans/plan-monitor.service.ts) tracks over time — e.g. "pay off
// the car loan in 18 months" or "save ₹12,00,000 for a house in 3 years". Deliberately
// NOT a full re-derivation of Goal/Loan/RetirementProfile: `targetMetricType` is a
// small free-text label (not a foreign key into a fifth different table) because the
// plan's job is to track ONE scalar number toward ONE target, however that number is
// computed by the Calculator/Retriever Agents — see PlanMonitorService for exactly how
// each targetMetricType is resolved back to a live number.
model CoachPlan {
  id               String          @id @default(cuid())
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String
  type             CoachPlanType
  title            String
  objective        String          // the user's own stated goal, kept verbatim for context
  linkedGoalId     String?         // optional Goal.id this plan tracks, when applicable
  linkedLoanId     String?         // optional Loan.id this plan tracks, when applicable
  targetMetricType String          // "goal_saved_amount" | "loan_outstanding_principal" | "retirement_corpus_gap" | "custom_amount"
  targetValue      Decimal         @db.Decimal(14, 2)
  targetDate       DateTime
  startingValue    Decimal         @db.Decimal(14, 2)
  currentValue     Decimal         @db.Decimal(14, 2)
  status           CoachPlanStatus @default(ACTIVE)
  lastCheckedAt    DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  steps    CoachPlanStep[]
  tasks    CoachTask[]
  progress CoachProgressSnapshot[]
  nudges   CoachNudge[]

  @@index([userId, status])
}

model CoachPlanStep {
  id          String          @id @default(cuid())
  plan        CoachPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  planId      String
  sequence    Int
  description String
  dueDate     DateTime?
  status      CoachStepStatus @default(PENDING)
  completedAt DateTime?
  createdAt   DateTime        @default(now())

  @@index([planId, sequence])
}

// Execution/Task Agent output — a concrete, actionable follow-up. Not every task is
// plan-bound (`planId` nullable): a one-off piece of advice from the ADVANCED path
// (e.g. "review your insurance gap") can also produce a task without a long-running
// plan behind it.
model CoachTask {
  id          String          @id @default(cuid())
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  plan        CoachPlan?      @relation(fields: [planId], references: [id], onDelete: SetNull)
  planId      String?
  title       String
  detail      String
  dueDate     DateTime?
  status      CoachTaskStatus @default(OPEN)
  sourceRunId String?         // AgenticCoachRun.id that produced this task, when applicable
  createdAt   DateTime        @default(now())
  completedAt DateTime?

  @@index([userId, status])
  @@index([planId])
}

// One row per execution-monitoring check (on-demand via a user's "how's my plan
// going" question, or proactive via the daily background scan) — the plan's own
// timeline, so progress can be charted and "on track vs not" compared over time
// rather than only ever knowing the single latest state.
model CoachProgressSnapshot {
  id          String               @id @default(cuid())
  plan        CoachPlan            @relation(fields: [planId], references: [id], onDelete: Cascade)
  planId      String
  checkedAt   DateTime             @default(now())
  metricValue Decimal              @db.Decimal(14, 2)
  onTrack     Boolean
  note        String
  source      CoachProgressSource

  @@index([planId, checkedAt])
}

// Proactive coaching output — a nudge the background monitor (or an on-demand check)
// decided was worth surfacing to the user without them having asked a question first.
model CoachNudge {
  id        String             @id @default(cuid())
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  plan      CoachPlan?         @relation(fields: [planId], references: [id], onDelete: SetNull)
  planId    String?
  severity  CoachNudgeSeverity @default(INFO)
  message   String
  dismissed Boolean            @default(false)
  createdAt DateTime           @default(now())

  @@index([userId, dismissed])
}

// --- Phase 13: Scenario Studio ------------------------------------------------------
//
// See README "Phase 13 — Scenario Studio" for the full design. Built entirely on top
// of the existing deterministic SimulatorService/simulator.engine.ts (Phase 5) — every
// variant's numbers come from that same engine, re-run with different (deterministically
// derived) parameters. Nothing here invents a financial projection; the AI layer only
// parses prompts into structured params and explains an already-computed ranking.

model ScenarioStudioRun {
  id              String   @id @default(cuid())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  prompt          String
  scenarioType    String
  baseParams      Json
  targetGoalIds   String[]
  variants        Json // summarized per-variant results (label, params, key numbers, feasibility)
  sensitivity     Json // SensitivityDimension[] output
  rankedOrder     String[] // variant labels, best to worst
  explanation     String
  explanationConfidence Decimal @db.Decimal(4, 3)
  verificationPassed Boolean
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
}

// --- Phase 14: ML Insights ----------------------------------------------------------
//
// See README "Phase 14 — ML Insights" for the full design. Every model behind this log
// is real, named, documented statistical computation (MAD-based anomaly detection,
// least-squares regression, a hand-specified scorecard, a logistic function, a
// two-window z-test, per-user z-score segmentation) over the app's own data — no
// external model call, nothing routed through AiGatewayService. This table is an
// evaluation/audit trail (headline numbers per run), not the full model output; the
// full ModelOutput<T> shapes are computed fresh on each request, not read back from
// here.

model MlInsightRun {
  id                  String   @id @default(cuid())
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              String
  anomalyCount        Int
  cashflowStressRisk  Boolean
  debtRiskScore       Int
  debtRiskTier        String
  driftDetected       Boolean
  driftDirection      String
  summary             Json // full MlInsightsSummary snapshot, for the history view
  createdAt           DateTime @default(now())

  @@index([userId, createdAt])
}

// --- Phase 15: Copilot Ingestion -----------------------------------------------------
//
// See README "Phase 15 — Copilot Ingestion" for the full design. A staged review
// queue, not a direct-write pipeline — nothing here creates an Expense row until a
// human explicitly approves an IngestionReviewItem (see IngestionReviewService).
// Conflict resolution against existing manual data happens at approval time via
// `duplicateResolution`, not silently at parse time.

enum IngestionItemStatus {
  PENDING
  APPROVED
  REJECTED
}

// Learning feedback loop + OCR + reconciliation additions below (IngestionSourceType,
// TransactionKind, MerchantCategoryMemory, MerchantCategoryGlobalStat,
// SuggestionRankingProfile, and the new fields on IngestionBatch/IngestionReviewItem)
// are scoped entirely to the Copilot Ingestion feature — see
// merchant/merchant-memory.service.ts, scoring/category-ranking.model.ts, and
// reconciliation/reconciliation.service.ts for the services that own them.

enum IngestionSourceType {
  TEXT
  OCR_IMAGE
}

enum TransactionKind {
  EXPENSE
  LOAN_EMI
  INVESTMENT_CONTRIBUTION
}

model IngestionBatch {
  id                      String                 @id @default(cuid())
  user                    User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                  String
  sourceLabel             String // free text the user gave this import, e.g. "HDFC Feb statement"
  ingestionSource         IngestionSourceType    @default(TEXT)
  // Set only when ingestionSource is OCR_IMAGE — see OcrQualityEstimationService.
  // Null (not 0) for a TEXT-sourced batch, since "no OCR was performed" is a different
  // fact than "OCR was performed and scored zero confidence."
  ocrExtractionConfidence Decimal?               @db.Decimal(4, 3)
  rawTextExcerpt          String // truncated, PII-scrubbed copy of the input, for audit — not the full statement text long-term
  totalLines              Int
  parsedCount             Int
  unparsedCount           Int
  items                   IngestionReviewItem[]
  createdAt               DateTime               @default(now())

  @@index([userId, createdAt])
}

model IngestionReviewItem {
  id                        String              @id @default(cuid())
  batch                     IngestionBatch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  batchId                   String
  user                      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                    String
  rawLine                   String
  parsedDate                DateTime
  parsedAmount              Decimal             @db.Decimal(14, 2)
  merchantRaw               String
  merchantNormalized        String
  suggestedCategoryId       String?
  suggestedCategoryName     String?
  categorySuggestionConfidence Decimal          @db.Decimal(4, 3)
  // Which signal produced suggestedCategoryId — "personal_memory" | "personal_memory_fuzzy"
  // (both persisted as "memory" — see CategorySuggestionService) | "ai" | "global" |
  // "blended" | "rule_based_fallback" | "none". Plain String (not an enum) because
  // CategoryRankingModel's SuggestionSource union is an application-level concept that
  // may grow new blend labels without needing a migration each time — the same
  // reasoning IngestionReviewItem.duplicateResolution below already uses.
  suggestionSource          String              @default("none")
  // Personal merchant memory's total observation count for this merchant at
  // suggestion time (0 if never seen) — see ACTIVE_LEARNING_MIN_SAMPLE_SIZE.
  merchantMemorySampleSize  Int                 @default(0)
  isDuplicateCandidate      Boolean
  duplicateOfExpenseId      String?
  duplicateConfidence       Decimal             @db.Decimal(4, 3)
  isRecurringCandidate      Boolean
  recurringMatchMerchant    String?
  isAnomalyCandidate        Boolean
  anomalyZScore             Decimal?            @db.Decimal(6, 2)
  // Set by ReconciliationService.classifyLine() at ingest time — routing only
  // (which comparison applies), never used to auto-create/auto-modify a Loan/
  // Investment record.
  transactionKind           TransactionKind     @default(EXPENSE)
  reconciliationNote        String?
  missingFields             String[]
  overallConfidence         Decimal             @db.Decimal(4, 3)
  rationale                 String
  // True when this item should be prioritized in the review queue regardless of its
  // raw confidence number — either the merchant has too few prior observations to
  // trust, or the blended confidence itself is below the active-learning bar. See
  // SuggestionScoringService and ACTIVE_LEARNING_CONFIDENCE_THRESHOLD.
  needsActiveLearningReview Boolean             @default(false)
  status                    IngestionItemStatus @default(PENDING)
  resolvedExpenseId         String?
  duplicateResolution       String? // "kept_both" | "skipped_duplicate" | "merged" — set only when isDuplicateCandidate was true
  createdAt                 DateTime            @default(now())
  resolvedAt                DateTime?

  @@index([userId, status])
  @@index([batchId])
  @@index([userId, needsActiveLearningReview])
}

// Personal, per-user merchant -> category memory. Written only from
// IngestionReviewService#approve() (a real human decision), read from
// CategorySuggestionService on every new suggestion. See MerchantMemoryService for the
// full decay/relearning behavior.
model MerchantCategoryMemory {
  id                 String   @id @default(cuid())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String
  merchantNormalized String
  categoryId         String
  categoryName       String
  // Decayed at read time (MerchantMemoryService), never destructively overwritten by
  // decay itself — this column always holds the last *reinforced* confidence value.
  confidence         Decimal  @db.Decimal(4, 3)
  acceptedCount      Int      @default(0)
  overrideCount      Int      @default(0)
  // Sentence embedding of merchantNormalized, for fuzzy (cosine-similarity) matching
  // of near-variant merchant strings — see MerchantMemoryService#lookupFuzzy. Brute-
  // force scanned per user (bounded by MERCHANT_MEMORY_FUZZY_CANDIDATE_LIMIT), the
  // same no-vector-index approach AiEmbeddingChunk already uses for RAG.
  embedding          Float[]
  lastAcceptedAt     DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([userId, merchantNormalized])
  @@index([userId])
}

// Cross-user, privacy-safe prior: a normalized merchant string mapped to a category
// NAME (never an id — categories are looked up by name against the calling user's own
// list, see MerchantMemoryService#globalLookup) with a bare occurrence count. This is
// deliberately the only cross-user data this feature writes — no userId, no amounts,
// no dates, no raw statement text, no embeddings. See the PII-shape guard in
// MerchantMemoryService#bumpGlobalStat applied before every write here.
model MerchantCategoryGlobalStat {
  id                 String   @id @default(cuid())
  merchantNormalized String
  categoryName       String
  count              Int      @default(1)
  updatedAt          DateTime @updatedAt

  @@unique([merchantNormalized, categoryName])
  @@index([merchantNormalized])
}

// Per-user weights for CategoryRankingModel's linear blend of {memory, ai, global}
// category candidates — nudged after every human approval/override
// (learnFromCorrection), read on every suggestion (rank). Bounded, symmetric online
// learning, not a persisted black-box model — see category-ranking.model.ts.
model SuggestionRankingProfile {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String   @unique
  weightMemory Decimal  @db.Decimal(4, 3) @default(0.5)
  weightAi     Decimal  @db.Decimal(4, 3) @default(0.4)
  weightGlobal Decimal  @db.Decimal(4, 3) @default(0.1)
  sampleCount  Int      @default(0)
  updatedAt    DateTime @updatedAt
}

// --- Phase 5: AI Coach, What-If Simulator ----------------------------------------

enum ScenarioType {
  SALARY_HIKE
  SALARY_DROP
  SIP_INCREASE
  SIP_DECREASE
  HOUSE_PURCHASE
  LOAN_PREPAYMENT
  RETIREMENT_AGE_SHIFT
  EMERGENCY_EXPENSE
  GOAL_DELAY
}

// Every AI Coach answer is logged with which grounded data sources it drew from and
// whether the question was answerable at all — this is the audit trail that lets us
// prove "grounded only in existing app data" rather than just asserting it.
model CoachInteraction {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  question      String
  matchedIntent String?  // null when the question was refused/unsupported
  answer        String
  dataSources   String[] // e.g. ["dashboard", "goals"] — which services were queried
  wasRefused    Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
}

// Stores a computed scenario result so the user can revisit/compare runs later. The
// calculation itself (SimulatorEngine) is a pure function with no DB access — this
// table only persists inputs + the already-computed output snapshot.
model SavedScenario {
  id             String        @id @default(cuid())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  scenarioType   ScenarioType
  label          String
  params         Json
  resultSnapshot Json
  createdAt      DateTime      @default(now())

  @@index([userId, createdAt])
}
